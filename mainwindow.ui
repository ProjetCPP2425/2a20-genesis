       <property name="styleSheet">
        <string notr="true">QLineEdit {
    background: #ffffff; /* White background for a clean, minimal look */
    border: 2px solid #213555; /* Vibrant blue border */
    border-radius: 12px; /* Rounded corners */
    padding: 8px;
    font-size: 13px; /* Réduction de la taille de la police */
    color: #333333; /* Dark text color for readability */
    selection-background-color: #1e90ff; /* Blue selection highlight */
    selection-color: #ffffff; /* White text on selection */
    font-weight: bold;
    letter-spacing: 1px;
    transition: all 0.3s ease; /* Smooth transition for focus effect */
}

QLineEdit:focus {
    border: 2px solid #00bfff; 
    background: #f5f5f5; 
    box-shadow: 0 4px 10px rgba(30, 144, 255, 0.4); 
}
</string>
