        <string notr="true">QPushButton {
    background: #213555; /* Updated to the new blue color */
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    transition: 0.3s;
}

QPushButton:hover {
    background: #1a2a3b; /* Darker shade of #213555 for hover */
}

QPushButton:pressed {
    background: #17263a; /* Even darker shade for pressed state */
}
