      <property name="styleSheet">
       <string notr="true">QGroupBox {
	min-width: 300px;  /* Largeur minimale */
    min-height: 200px; 
    background: #f9f8f8;
    border: 2px solid #3e5879;
    border-radius: 15px;
    padding: 15px;
    font-size: 16px;
    font-weight: bold;
    color: #333;
    box-shadow: 6px 6px 10px #c9ced6, -6px -6px 10px #ffffff;
}

QGroupBox:title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 5px;
    color: #555;
