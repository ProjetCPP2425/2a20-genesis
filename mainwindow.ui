    transition: all 0.3s ease-in-out;
}

QPushButton:hover {
    background-color: #f5efe7;
    color: #213555;
    border: 2px solid #3e5879;
}

QPushButton:pressed {
    background-color: #213555;
    color: white;
    border: 2px solid #3e5879;
}

/* 🌟 Action Buttons */
QPushButton#edit {
    background-color: #3e5879;
    color: white;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#delete {
    background-color: #d9534f;
    color: white;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#delete:hover {
    background-color: #c9302c;
}

/* 🌟 Tables */
QTableWidget {
    border: 2px solid #3e5879;
    background-color: #f5efe7;
    gridline-color: #3e5879;
}

QHeaderView::section {
    background-color: #213555;
    color: white;
    padding: 7px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
}

QTableWidget::item:hover {
    background-color: #e0d6cd;
}

/* 🌟 Sidebar */
QFrame#sidebar {
    background-color: #213555;
    color: white;
    border-radius: 10px;
}

QListWidget#menu {
    background: transparent;
    color: #f5efe7;
    font-size: 14px;
    border: none;
}

QListWidget#menu::item:hover {
    background-color: #3e5879;
    color: white;
    border-radius: 5px;
    padding: 5px;
}

/* 🌟 Search Bar */
QLineEdit#searchBar {
    border: 2px solid #3e5879;
    border-radius: 8px;
    padding: 6px;
    font-size: 14px;
    background-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 2px solid #213555;
}
