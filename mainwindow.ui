     <property name="styleSheet">
      <string notr="true">QTableWidget {

    background-color: #ffffff; /* Set background color to white */
    border: 1px solid #d6d9dc;
    gridline-color: #dee2e6;
    selection-background-color: #213555; /* Blue selection background */
    selection-color: white;
    alternate-background-color: #eef2f5;
    border-radius: 8px;
    font-size: 14px;
    padding: 0;
    margin: 0;
    width: 100%; /* Ensures table takes full width of container */
    table-layout: fixed; /* Forces columns to stay equal width */
}

QTableWidget::item {
    padding: 0; /* No padding inside cells */
    border: none; /* Remove internal borders */
}

QHeaderView::section {
	 font-weight: bold;
    background-color: #213555; /* Blue background for header */
    color: white;
    padding: 5px 10px;
    border: none;
    font-size: 14px;
    border-bottom: 2px solid #2e4566;
}

QTableWidget QTableCornerButton::section {
    background-color: transparent;
    border: none;
}

QTableWidget::item:selected {
    background-color: #213555; /* Blue background for selected items */
    color: white;
    border-radius: 4px;
}

QTableWidget::corner {
    background-color: transparent; /* Remove any corner area background */
}

QTableWidget::column {
    width: 20%; /* Fixed column width for each column (5 columns) */
}

QHeaderView {
    margin: 0; /* Remove any margins from the header */
    padding: 0; /* Remove padding from header */
    border: none; /* Ensure no extra border */
}

/* Fix any cell overflow or stretch */
QTableWidget::item {
    white-space: nowrap; /* Prevent content overflow */
    text-overflow: ellipsis; /* Add ellipsis for overflow */
}

QTableWidget::column {
    width: 100px; /* Set a specific column width */
}
</string>
